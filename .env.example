# Copy this file to .env and set these values before sending external mail.
# The hostname should resolve to the outbound public IP and match its reverse DNS.
FQ_MAIL_HOSTNAME=mail.example.com
FQ_MAIL_FROM=fullyqualified@example.com

# Change this if it overlaps a network on the Docker host.
FQ_SMTP_SUBNET=172.30.25.0/29

# Optional: use an external SMTP service instead of the bundled Postfix relay.
# FQ_SMTP_HOST=postfix
# FQ_SMTP_PORT=25
# FQ_SMTP_SSL=false
# FQ_SMTP_USER=
# FQ_SMTP_PASSWORD=
