@page "/alerts"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = Roles.Admin)]
@inject IStringLocalizer<SharedResource> L
@inject AlertSettingsService Settings
@inject AlertService AlertSvc
@inject IConfiguration Config
@inject AppDbContext Db

<PageTitle>@L["Nav_Alerts"]</PageTitle>
<h1>@L["Alerts_Title"]</h1>
<p><a href="/email-test">@L["EmailTest_Title"]</a></p>
<AdminRoot>
    <section class="card narrow wide" id="alerts-form"
             data-saved="@L["Alerts_Saved"]" data-test-ok="@L["Alerts_TestOk"]" data-test-failed="@L["Alerts_TestFailed"]" data-test-none="@L["Alerts_TestNone"]"
             data-msg-invalid_status="@L["Err_InvalidStatus"]" data-msg-invalid_slack="@L["Err_InvalidSlack"]" data-msg-invalid_webhook="@L["Err_InvalidWebhook"]"
             data-msg-blocked_host="@L["Err_BlockedHost"]" data-msg-no_channels="@L["Err_NoChannels"]"
             data-msg-invalid_telegram_token="@L["Err_InvalidTelegramToken"]" data-msg-invalid_telegram_chat="@L["Err_InvalidTelegramChat"]" data-msg-telegram_incomplete="@L["Err_TelegramIncomplete"]">
        <p>@L["Alerts_Intro"]</p>
        @if (usingServerSettings)
        {
            <p class="muted">@L["Alerts_ServerDefaults"]</p>
        }

        <label class="check-row"><input type="checkbox" id="al-enabled" checked="@enabled" /> @L["Alerts_Enabled"]</label>

        <h2>@L["Alerts_Channels"]</h2>
        <label for="al-slack">@L["Alerts_Slack"]</label>
        <input id="al-slack" type="url" autocomplete="off" placeholder="@(slackHost is null ? "https://hooks.slack.com/services/…" : L["Alerts_Configured", slackHost].Value)" />
        @if (slackHost is not null) { <label class="check-row"><input type="checkbox" id="al-clear-slack" /> @L["Alerts_Remove"]</label> }

        <label for="al-webhook">@L["Alerts_Webhook"]</label>
        <input id="al-webhook" type="url" autocomplete="off" placeholder="@(webhookHost is null ? "https://events.pagerduty.com/…" : L["Alerts_Configured", webhookHost].Value)" />
        @if (webhookHost is not null) { <label class="check-row"><input type="checkbox" id="al-clear-webhook" /> @L["Alerts_Remove"]</label> }

        <label for="al-telegram">@L["Alerts_Telegram"]</label>
        <input id="al-telegram" type="password" autocomplete="off" placeholder="@(telegramBot is null ? "123456789:AAH…" : L["Alerts_TelegramConfigured", telegramBot].Value)" />
        <label for="al-telegram-chat">@L["Alerts_TelegramChat"]</label>
        <input id="al-telegram-chat" value="@telegramChat" autocomplete="off" placeholder="-1001234567890 / @@mychannel" />
        <small class="muted">@L["Alerts_TelegramHelp"]</small>
        <details class="howto">
            <summary>@L["TgHow_Title"]</summary>
            <ol>
                <li>@L["TgHow_1"] <code>/newbot</code>. @L["TgHow_1b"]</li>
                <li>@L["TgHow_2"] <code>123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw0</code></li>
                <li>@L["TgHow_3"]</li>
                <li>@L["TgHow_4"] <code>https://api.telegram.org/bot&lt;@L["TgHow_Token"]&gt;/getUpdates</code><br />
                    @L["TgHow_4b"] <code>"chat":{"id":<b>-1001234567890</b>,…}</code></li>
                <li>@L["TgHow_5"]</li>
            </ol>
            <p class="muted"><small>@L["TgHow_Secret"]</small></p>
        </details>
        @if (telegramBot is not null) { <label class="check-row"><input type="checkbox" id="al-clear-telegram" /> @L["Alerts_Remove"]</label> }

        <label for="al-email">@L["Alerts_Email"]</label>
        <input id="al-email" value="@emailTo" autocomplete="off" placeholder="it@example.com, security@example.com" />
        @if (!AlertSvc.CanMail) { <small class="muted">@L["Alerts_NoSmtp"]</small> }

        <h2>@L["Alerts_When"]</h2>
        <label for="al-min">@L["Alerts_Minimum"]</label>
        <select id="al-min">
            @foreach (var s in new[] { CheckStatus.Warning, CheckStatus.Error, CheckStatus.Critical })
            {
                <option value="@s" selected="@(s == min)">@L["Status_" + s]</option>
            }
        </select>
        <label class="check-row"><input type="checkbox" id="al-recovery" checked="@recovery" /> @L["Alerts_Recovery"]</label>
        <label class="check-row"><input type="checkbox" id="al-drift" checked="@drift" /> @L["Alerts_Drift"]</label>

        <p class="actions">
            <button type="button" data-admin="alerts-save">@L["Alerts_Save"]</button>
            <button type="button" class="secondary" data-admin="alerts-test">@L["Alerts_Test"]</button>
        </p>
        <p id="al-note" class="muted" role="status" hidden></p>
    </section>

    <section class="card narrow wide" id="alert-rules">
        <h2>@L["Rules_Title"]</h2>
        <p>@L["Rules_Intro"]</p>
        @if (drift) { <p class="muted"><small>@L["Rules_DriftOn"]</small></p> }
        @if (rules.Count == 0) { <p class="muted">@L["Rules_Empty"]</p> }
        else
        {
            <table>
                <thead><tr><th>@L["Rules_Value"]</th><th>@L["Rules_Asset"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in rules)
                    {
                        <tr>
                            <td>@L["Check_" + r.CheckType]: @RuleKeyLabel(r.Key)</td>
                            <td>@(r.AssetId is { } id && assetNames.TryGetValue(id, out var n) ? n : L["Rules_AllAssets"].Value)</td>
                            <td><button type="button" class="secondary" data-rule-remove="@r.Id">@L["Rules_Remove"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <h3>@L["Rules_AddTitle"]</h3>
        <label for="rule-key">@L["Rules_Value"]</label>
        <select id="rule-key">
            @foreach (var group in AlertRules.CheckTypes)
            {
                <optgroup label="@L["Check_" + group]">
                    <option value="@group|@AlertRules.AnyKey">@RuleKeyLabel(AlertRules.AnyKey)</option>
                    @foreach (var c in AlertRules.Catalog.Where(c => c.CheckType == group))
                    {
                        <option value="@c.CheckType|@c.Key">@RuleKeyLabel(c.Key)</option>
                    }
                </optgroup>
            }
        </select>
        <label for="rule-asset">@L["Rules_Asset"]</label>
        <select id="rule-asset">
            <option value="">@L["Rules_AllAssets"]</option>
            @foreach (var a in assets) { <option value="@a.Id">@a.Name</option> }
        </select>
        <p class="actions"><button type="button" data-admin="rule-add">@L["Rules_Add"]</button></p>
    </section>
</AdminRoot>

@code {
    bool enabled = true, recovery = true, drift = true, usingServerSettings;
    string? slackHost, webhookHost, emailTo, telegramBot, telegramChat;
    CheckStatus min = CheckStatus.Warning;
    List<AlertRule> rules = [];
    List<(Guid Id, string Name)> assets = [];
    Dictionary<Guid, string> assetNames = [];

    string RuleKeyLabel(string key) => L["RuleKey_" + (key == AlertRules.AnyKey ? "any" : key)].Value;

    protected override async Task OnInitializedAsync()
    {
        rules = await Db.AlertRules.OrderBy(r => r.CheckType).ThenBy(r => r.Key).ToListAsync();
        assets = (await Db.Assets.OrderBy(a => a.Name).Select(a => new { a.Id, a.Name }).ToListAsync()).Select(a => (a.Id, a.Name)).ToList();
        assetNames = assets.ToDictionary(a => a.Id, a => a.Name);
        var row = await Settings.CurrentAsync();
        if (row is null)
        {
            usingServerSettings = !string.IsNullOrWhiteSpace(Config["Alerts:SlackWebhook"]) || !string.IsNullOrWhiteSpace(Config["Alerts:Webhook"]) || !string.IsNullOrWhiteSpace(Config["Alerts:Email:To"]) || !string.IsNullOrWhiteSpace(Config["Alerts:Telegram:BotToken"]);
            return;
        }
        enabled = row.Enabled; recovery = row.NotifyRecovery; drift = row.NotifyDrift; min = row.MinStatus; emailTo = row.EmailTo;
        slackHost = AlertSettingsService.Describe(Settings.Reveal(row.SlackWebhook));
        webhookHost = AlertSettingsService.Describe(Settings.Reveal(row.WebhookUrl));
        telegramBot = AlertSettingsService.DescribeToken(Settings.Reveal(row.TelegramBotToken));
        telegramChat = row.TelegramChatId;
    }
}
