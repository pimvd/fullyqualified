@page "/reports"
@inject IStringLocalizer<SharedResource> L
@inject PlanService Plans

<PageTitle>@L["Nav_Reports"]</PageTitle>
<h1>@L["Reports_Title"]</h1>
<section class="card">
    <p>@L["Reports_Intro"]</p>
    @if (allowed)
    {
        <p class="actions">
            <a class="button" href="/reports/nis2.xlsx">@L["Reports_Excel"]</a>
            <a class="button" href="/reports/nis2.pdf">@L["Reports_Pdf"]</a>
        </p>
    }
    else
    {
        <p class="notice" role="note">@L["Reports_NotInPlan"]</p>
    }
</section>

@code {
    [CascadingParameter] HttpContext? Ctx { get; set; }
    bool allowed;

    protected override async Task OnInitializedAsync() =>
        allowed = Roles.TenantId(Ctx?.User) is { } id && (await Plans.ForAsync(id))?.Limits.ReportsEnabled == true;
}
