@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResource> L
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>@L["Login_Title"]</PageTitle>
<PasskeyRoot Return="@ReturnUrl">
    <section class="card narrow">
        <h1>@L["Login_Title"]</h1>
        <p>@L["Login_Intro"]</p>
        <button type="button" data-passkey="login">@L["Login_Button"]</button>
    </section>
</PasskeyRoot>

@code {
    [CascadingParameter] HttpContext? Ctx { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Ctx?.User.Identity?.IsAuthenticated == true) Nav.NavigateTo("/");
        else if (!await Db.Users.AnyAsync()) Nav.NavigateTo("/setup");
    }
}
