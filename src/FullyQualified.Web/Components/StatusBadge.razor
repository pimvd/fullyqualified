@inject IStringLocalizer<SharedResource> L
@if (Paused)
{
    <span class="badge paused">@L["Status_Paused"]</span>
}
else if (Status is { } s)
{
    <span class="badge @s.ToString().ToLowerInvariant()">@L["Status_" + s]</span>
}
else
{
    <span class="badge pending">@L["Status_Pending"]</span>
}
@code {
    [Parameter] public CheckStatus? Status { get; set; }
    /// <summary>A paused asset shows as paused whatever its last results were.</summary>
    [Parameter] public bool Paused { get; set; }
}
