@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav
@{
    var back = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri).Insert(0, "/"));
}
@if (signedIn)
{
    <div class="shell">
        <aside class="side">
            <a class="brand" href="/">Fully<span>Qualified</span></a>
            <button type="button" class="dig-open side-dig" data-dig-open title="@L["Dig_Hint"]">⌕ <span>@L["Dig_Open"]</span> <kbd>/</kbd></button>
            <nav aria-label="@L["Nav_Dashboard"]">
                <a href="/" class="@Active("/")">@L["Nav_Dashboard"]</a>
                <a href="/certificates" class="@Active("certificates")">@L["Nav_Certificates"]</a>
                <a href="/changes" class="@Active("changes")">@L["Nav_Changes"]</a>
                <a href="/review" class="@Active("review")">@L["Nav_Review"]</a>
                <a href="/reports" class="@Active("reports")">@L["Nav_Reports"]</a>
                <a href="/log" class="@Active("log")">@L["Nav_Log"]</a>
                <a href="/toolbox" class="@Active("toolbox")">@L["Tool_Title"]</a>
            </nav>
        </aside>
        <div class="content">
            <header class="bar">
                <nav aria-label="@L["Nav_Account"]">
                    @if (Roles.IsPlatformAdmin(Ctx?.User)) { <a href="/tenants" class="@Active("tenants")">@L["Nav_Tenants"]</a><a href="/limits" class="@Active("limits")">@L["Nav_Limits"]</a><a href="/settings" class="@Active("settings")">@L["Nav_Settings"]</a> }
                    @if (Roles.IsAdmin(Ctx?.User)) { <a href="/alerts" class="@Active("alerts")">@L["Nav_Alerts"]</a><a href="/users" class="@Active("users")">@L["Nav_Users"]</a><a href="/organization" class="@Active("organization")">@L["Nav_Organization"]</a> }
                    <a href="/account" class="@Active("account")">@L["Nav_Account"]</a>
                </nav>
                <div class="bar-tools">
                    @* Loads the page again with a plain GET, so it also works on a page that came from a form post. *@
                    <button type="button" class="refresh" data-refresh title="@L["Refresh"]" aria-label="@L["Refresh"]" onclick="window.location.assign(window.location.href)">⟳</button>
                    <span class="lang"><a href="/culture?culture=en&redirect=@back">EN</a> · <a href="/culture?culture=nl&redirect=@back">NL</a></span>
                    <form method="post" action="/auth/logout"><button type="submit" class="link">@L["Nav_SignOut"]</button></form>
                </div>
            </header>
            <main>@Body</main>
        </div>
    </div>
    <DigDialog />
}
else
{
    <header class="top">
        <a class="brand" href="/">Fully<span>Qualified</span></a>
        <nav></nav>
        <button type="button" class="refresh" data-refresh title="@L["Refresh"]" aria-label="@L["Refresh"]" onclick="window.location.assign(window.location.href)">⟳</button>
        <div class="lang">
            <a href="/culture?culture=en&redirect=@back">EN</a> ·
            <a href="/culture?culture=nl&redirect=@back">NL</a>
        </div>
    </header>
    <main>@Body</main>
}

@code {
    [CascadingParameter] HttpContext? Ctx { get; set; }
    bool signedIn => Ctx?.User.Identity?.IsAuthenticated == true;

    /// <summary>Marks the current section in the side navigation. "/" only matches the dashboard itself.</summary>
    string? Active(string section)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        return section == "/" ? (path == "/" ? "on" : null)
            : path == "/" + section || path.StartsWith("/" + section + "/", StringComparison.Ordinal) ? "on" : null;
    }
}
