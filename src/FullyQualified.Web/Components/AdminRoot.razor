@inject IStringLocalizer<SharedResource> L
<div data-admin-root data-confirm-user="@L["Users_ConfirmRemove"]" data-confirm-invite="@L["Invites_ConfirmRevoke"]"
     data-emailed="@L["Invites_Emailed"]" data-copy="@L["Invites_Copy"]" data-recovery="@L["Recovery_Created"]"
     data-msg-last_admin="@L["Err_LastAdmin"]" data-msg-cannot_remove_self="@L["Err_CannotRemoveSelf"]" data-msg-cannot_reset_self="@L["Err_CannotResetSelf"]"
     data-msg-email_exists="@L["Err_EmailExists"]" data-msg-invalid_email="@L["Err_InvalidEmail"]"
     data-msg-invalid_role="@L["Err_InvalidRole"]" data-msg-not_found="@L["Err_NotFound"]"
     data-msg-tenant_exists="@L["Err_TenantExists"]" data-msg-invalid_name="@L["Err_InvalidName"]"
     data-msg-invalid_tier="@L["Err_InvalidTier"]" data-msg-invalid_limit="@L["Err_InvalidLimit"]" data-msg-confirm_mismatch="@L["Err_ConfirmMismatch"]"
     data-msg-management_tenant="@L["Err_ManagementTenant"]" data-msg-user_limit="@L["Err_UserLimit"]" data-saved="@L["Alerts_Saved"]"
     data-msg-invalid_rule="@L["Err_InvalidRule"]" data-msg-rule_exists="@L["Err_RuleExists"]" data-msg-too_many_rules="@L["Err_TooManyRules"]" data-confirm-rule="@L["Rules_ConfirmRemove"]"
     data-msg-unknown_setting="@L["Err_UnknownSetting"]" data-msg-invalid_value="@L["Err_InvalidValue"]" data-msg-invalid_number="@L["Err_InvalidNumber"]"
     data-msg-invalid_bool="@L["Err_InvalidValue"]" data-msg-invalid_choice="@L["Err_InvalidChoice"]" data-msg-too_long="@L["Err_TooLong"]"
     data-msg-forbidden="@L["Err_Forbidden"]" data-msg-failed="@L["Err_Failed"]">
    @ChildContent
    <p id="adm-error" class="error" role="alert" hidden></p>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
